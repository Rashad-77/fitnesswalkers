APP_NAME=FitnessWalkers
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.lk
APP_TIMEZONE=Asia/Colombo

LOG_CHANNEL=stack
LOG_LEVEL=warning

# register.lk (cPanel) MySQL. Create the database + user in cPanel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelname_fitness
DB_USERNAME=cpanelname_fitness
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Optional: a JSON feed of [{"name":"White Rice, cooked","price_per_kg":120}, ...]
PRICE_FEED_URL=
